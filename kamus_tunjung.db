-- 4: Pengelolaan & Operasi Data (CRUD Operations)

-- Insert entri utama
INSERT INTO dictionary_entries (indonesian_word, pos_id) 
VALUES ('Makan', 1) 
RETURNING id; -- Mengembalikan entry_id, misal: 101

-- Insert variasi terjemahan bahasa daerah
INSERT INTO translations (entry_id, language_code, translated_word, phonetic, audio_url, example_sentence, example_translation)
VALUES 
(101, 'tj', 'Kuman', '/ku.man/', '/media/audio/tj_kuman.mp3', 'yok kuman Rebayaq Tai.', 'Mari makan bersama kita .'),
(101, 'bq', 'Makan', '/Man/', '/media/audio/bq_makan.mp3', 'Yok Man iro.', 'Ayo makan itu.');
(101, 'ky', 'Makan', '/ma.kan/', '/media/audio/ky_makan.mp3', 'Yok makan jua.', 'Ayo makan juga.');
(101, 'bh', 'Makan', '/ma.kan/', '/media/audio/bh_makan.mp3', 'Yok makan jua.', 'Ayo makan juga.');
(101, 'kt', 'Makan', '/ma.kan/', '/media/audio/kt_makan.mp3', 'Yok meko jua.', 'Ayo makan juga.');


-- 5: Pencarian Cepat (Query / Read)
SELECT 
    e.indonesian_word,
    t.language_code,
    t.translated_word,
    t.phonetic,
    t.audio_url,
    t.example_sentence
FROM dictionary_entries e
JOIN translations t ON e.id = t.entry_id
WHERE e.indonesian_word ILIKE 'makan%';

-- 6: Manajemen Versi Dataset (Versioning)
CREATE TABLE dataset_logs (
    id SERIAL PRIMARY KEY,
    entry_id INT,
    action VARCHAR(20), -- 'CREATE', 'UPDATE', 'DELETE'
    changed_by VARCHAR(100),
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


