-- kamus_tunjung.db (SQL script to create and populate SQLite database)
-- This file is a SQL dump that creates the schema for the kamus and
-- instructs how to import CSV data included in this repository.

PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;

-- Table for Tonyooi -> Indonesia pairs
CREATE TABLE IF NOT EXISTS tonyooi_to_indonesia (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  tonyooi TEXT NOT NULL,
  indonesia TEXT
);

-- Table for Indonesia -> Tonyooi pairs
CREATE TABLE IF NOT EXISTS indonesia_to_tonyooi (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  indonesia TEXT NOT NULL,
  tonyooi TEXT
);

-- Note: rather than embedding many INSERT statements here, import the CSV files
-- included in the repository using the sqlite3 CLI. Example:
--  $ sqlite3 kamus_tunjung.db
--  sqlite> .mode csv
--  sqlite> .import tunjung_to_indonesia.csv tunjung_to_indonesia
--  sqlite> .import indonesia_to_tunjung.csv indonesia_to_tunjung
--  sqlite> .schema
--  sqlite> .quit

COMMIT;

-- Optional example insert (uncomment to use):
-- INSERT INTO tonyooi_to_indonesia(tonyooi, indonesia) VALUES('Ampaap','Cahaya, sinar, terang');
-- INSERT INTO indonesia_to_tonyooi(indonesia, tonyooi) VALUES('Akan, hendak','Antakng');

-- 1: Relational Database (SQL - PostgreSQL / MySQL / SQLite)
-- Main Terms Table
CREATE TABLE words (
    id SERIAL PRIMARY KEY,
    word VARCHAR(255) NOT NULL UNIQUE,
    phonetic VARCHAR(100),
    language VARCHAR(10) DEFAULT 'en',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Meanings / Definitions Table (1 Word -> Multiple Meanings)
CREATE TABLE definitions (
    id SERIAL PRIMARY KEY,
    word_id INT REFERENCES words(id) ON DELETE CASCADE,
    part_of_speech VARCHAR(50), -- e.g., noun, verb, adjective
    definition TEXT NOT NULL,
    example TEXT
);

-- Synonyms & Antonyms
CREATE TABLE word_relations (
    id SERIAL PRIMARY KEY,
    word_id INT REFERENCES words(id) ON DELETE CASCADE,
    related_word_id INT REFERENCES words(id) ON DELETE CASCADE,
    relation_type VARCHAR(20) CHECK (relation_type IN ('synonym', 'antonym'))
);

-- 2: Translation / Bilingual Dictionary Database (e.g., Tunjung ↔ Indonesian)

CREATE TABLE source_words (
    id SERIAL PRIMARY KEY,
    word VARCHAR(255) NOT NULL,
    language_code VARCHAR(10) NOT NULL, -- e.g., 'tjo' (Tunjung)
    part_of_speech VARCHAR(50),
    phonetic VARCHAR(100)
);

CREATE TABLE target_translations (
    id SERIAL PRIMARY KEY,
    source_word_id INT REFERENCES source_words(id) ON DELETE CASCADE,
    translation VARCHAR(255) NOT NULL,
    target_language VARCHAR(10) NOT NULL, -- e.g., 'id' (Indonesian)
    definition_notes TEXT,
    context_example TEXT
);

